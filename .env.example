# ==============================================================================
# GRIDGUARD - SMART TRANSFORMER PROTECTION & ASSISTIVE LOAD DEVICE
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# FastAPI Backend Configuration
PROJECT_NAME="GRIDGUARD"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# JWT Security
JWT_SECRET="gridguard-super-secure-industrial-iot-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant local zero-dependency run)
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/gridguard"
DATABASE_URL="sqlite+aiosqlite:///./gridguard.db"

# Private HiveMQ Cloud Broker Credentials
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="gridguard_service_01"

# Gemini AI Advisory API Key (Backend Only - NEVER expose to browser)
GEMINI_API_KEY=""

# Email Dispatch Configuration for Critical Faults
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="alerts@gridguard.iot"

# Authoritative Protection Defaults (Configurable via Settings UI)
OVERCURRENT_THRESHOLD_A=2.50
OVERLOAD_THRESHOLD_VA=600.0
OVERVOLTAGE_THRESHOLD_V=250.0
UNDERVOLTAGE_THRESHOLD_V=190.0
FREQUENCY_MIN_HZ=47.5
FREQUENCY_MAX_HZ=52.5
POWER_FACTOR_MIN=0.80
PERSISTENCE_SEC=1.0
HYSTERESIS_PCT=5.0
LOAD_SHEDDING_DEMAND_LIMIT_W=1200.0

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:8000/ws/live"
