  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://gridguard-backend.onrender.com/api",
    "NEXT_PUBLIC_WS_URL": "wss://gridguard-backend.onrender.com/ws/live"
  }
}
